{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mysecondhorizon-threads",
  "main": "src/index.js",
  "compatibility_date": "2026-08-02",
  "observability": {
    "enabled": true
  },
  "kv_namespaces": [
    {
      "binding": "THREADS_KV",
      "id": "50e4051bef5048189637a5428fe16a80"
    }
  ],
  "r2_buckets": [
    {
      "binding": "THREADS_MEDIA",
      "bucket_name": "threads-media"
    }
  ],
  "triggers": {
    "crons": [
      "10 23 * * *",
      "30 2 * * *",
      "30 5 * * *",
      "40 9 * * *",
      "30 11 * * *"
    ]
  }
}

{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mysecondhorizon-threads",
  "main": "src/index.js",
  "compatibility_date": "2026-08-02",
  "vars": {
    "OPENAI_MODEL": "gpt-5.6-luna"
  },
  "observability": {
    "enabled": true
  },
  "images": {
    "binding": "IMAGES"
  },
  "media": {
    "binding": "MEDIA"
  },
  "containers": [
    {
      "class_name": "VideoNormalizerContainer",
      "image": "./containers/video-normalizer/Dockerfile",
      "instance_type": "standard-2",
      "max_instances": 1,
      "ssh": {
        "enabled": false
      }
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "VIDEO_NORMALIZER",
        "class_name": "VideoNormalizerContainer"
      },
      {
        "name": "SCHEDULE_COORDINATOR",
        "class_name": "ScheduleCoordinator"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "VideoNormalizerContainer"
      ]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": [
        "ScheduleCoordinator"
      ]
    }
  ],
  "kv_namespaces": [
    {
      "binding": "THREADS_KV",
      "id": "50e4051bef5048189637a5428fe16a80"
    }
  ],
  "r2_buckets": [
    {
      "binding": "THREADS_MEDIA",
      "bucket_name": "threads-media"
    }
  ],
  "triggers": {
    "crons": [
      "10 23 * * *",
      "30 2 * * *",
      "30 5 * * *",
      "40 9 * * *",
      "30 11 * * *"
    ]
  }
}
